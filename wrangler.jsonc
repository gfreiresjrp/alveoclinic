{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alveoclinic",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: o Next e o driver do banco usam APIs do Node.
  // global_fetch_strictly_public: fetch para o próprio domínio sai e volta,
  // como no Node — sem isso o Next quebra ao buscar as próprias rotas.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
